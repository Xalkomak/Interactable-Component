[node name="Description" type="Label3D" parent="Signboard" unique_id=540495391]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.4, 0.051)
text = "A rudimentary yet robust interaction system, all
compressed into a singular node. Take a look
around and try interacting with the four objects,
each set to four interaction modes.
1. One Shot: Interaction happens only once.
2. Toggle: Swtches between ON and OFF States.
3. Hold: Interaction continues as long as the
interaction button is held.
4. Always: Interaction is always active, regardless
of its internal state."
font_size = 28
